MONGODB_URI=
SESSION_SECRET=

# Web Push (npx web-push generate-vapid-keys --json)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Cron Authorization: Bearer <CRON_SECRET>
# Same value on Vercel env + GitHub Actions secret CRON_SECRET
CRON_SECRET=

# GitHub Actions only (not needed on Vercel): production origin
# CRON_APP_URL=https://your-app.vercel.app

# Optional: set to 0 to ignore preferred 15-min slot (debug only)
# REMINDER_MATCH_HOUR=1
